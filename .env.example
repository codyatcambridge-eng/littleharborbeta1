# Little Harbor — environment variables (beta)
#
# The beta ships with mock data so it runs with NO backend configured.
# These values are placeholders for when you wire up Supabase auth + Postgres.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the browser). Used by moderation/admin tooling.
SUPABASE_SERVICE_ROLE_KEY=
